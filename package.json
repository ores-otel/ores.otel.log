{
  "name": "@oresoftware/next-loggers",
  "version": "0.1.0",
  "description": "Runtime-aware structured loggers with native SDKs for JavaScript/TypeScript, Python, Go, Rust, WebAssembly, Java, Dart, Ruby, Gleam, Erlang, and Elixir",
  "type": "module",
  "types": "./dist/base-logger.d.ts",
  "sideEffects": false,
  "bin": {
    "next-loggers": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "src",
    "sdk/dart/lib",
    "sdk/dart/pubspec.yaml",
    "sdk/elixir/lib",
    "sdk/elixir/mix.exs",
    "sdk/erlang/src",
    "sdk/erlang/rebar.config",
    "sdk/gleam/src",
    "sdk/gleam/gleam.toml",
    "sdk/gleam/manifest.toml",
    "sdk/go/*.go",
    "sdk/go/go.mod",
    "sdk/java/src/main",
    "sdk/java/pom.xml",
    "sdk/python/src",
    "sdk/python/pyproject.toml",
    "sdk/ruby/lib",
    "sdk/ruby/oresoftware-next-loggers.gemspec",
    "sdk/rust/src",
    "sdk/rust/Cargo.toml",
    "sdk/rust/Cargo.lock",
    "sdk/rust-otel/src",
    "sdk/rust-otel/Cargo.toml",
    "sdk/wasm/src",
    "sdk/wasm/Cargo.toml",
    "sdk/wasm/Cargo.lock",
    "contracts",
    "docs",
    "formal",
    ".cli-flags.toml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "edge-light": {
        "types": "./dist/edge-logger.d.ts",
        "default": "./dist/edge-logger.js"
      },
      "workerd": {
        "types": "./dist/cloudflare-worker-logger.d.ts",
        "default": "./dist/cloudflare-worker-logger.js"
      },
      "worker": {
        "types": "./dist/edge-logger.d.ts",
        "default": "./dist/edge-logger.js"
      },
      "browser": {
        "types": "./dist/browser-logger.d.ts",
        "default": "./dist/browser-logger.js"
      },
      "deno": {
        "types": "./dist/deno-logger.d.ts",
        "default": "./dist/deno-logger.js"
      },
      "bun": {
        "types": "./dist/bun-logger.d.ts",
        "default": "./dist/bun-logger.js"
      },
      "node": {
        "types": "./dist/node-logger.d.ts",
        "default": "./dist/node-logger.js"
      },
      "types": "./dist/base-logger.d.ts",
      "import": "./dist/base-logger.js",
      "default": "./dist/base-logger.js"
    },
    "./base": {
      "types": "./dist/base-logger.d.ts",
      "default": "./dist/base-logger.js"
    },
    "./browser": {
      "types": "./dist/browser-logger.d.ts",
      "default": "./dist/browser-logger.js"
    },
    "./edge": {
      "types": "./dist/edge-logger.d.ts",
      "default": "./dist/edge-logger.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare-worker-logger.d.ts",
      "default": "./dist/cloudflare-worker-logger.js"
    },
    "./node": {
      "types": "./dist/node-logger.d.ts",
      "default": "./dist/node-logger.js"
    },
    "./bun": {
      "types": "./dist/bun-logger.d.ts",
      "default": "./dist/bun-logger.js"
    },
    "./deno": {
      "types": "./dist/deno-logger.d.ts",
      "default": "./dist/deno-logger.js"
    },
    "./context": {
      "browser": {
        "types": "./dist/context-browser.d.ts",
        "default": "./dist/context-browser.js"
      },
      "workerd": {
        "types": "./dist/context-workerd.d.ts",
        "default": "./dist/context-workerd.js"
      },
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./browser-stream": {
      "types": "./dist/browser-stream.d.ts",
      "default": "./dist/browser-stream.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "default": "./dist/otel.js"
    },
    "./loki": {
      "types": "./dist/loki.d.ts",
      "default": "./dist/loki.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "default": "./dist/observability.js"
    },
    "./internal-diagnostics": {
      "types": "./dist/internal-diagnostics.d.ts",
      "default": "./dist/internal-diagnostics.js"
    },
    "./internal-diagnostics/backend": {
      "types": "./dist/internal-diagnostics-backend.d.ts",
      "default": "./dist/internal-diagnostics-backend.js"
    },
    "./prometheus": {
      "types": "./dist/prometheus.d.ts",
      "default": "./dist/prometheus.js"
    },
    "./supabase-ingest": {
      "types": "./dist/supabase-ingest.d.ts",
      "default": "./dist/supabase-ingest.js"
    },
    "./supabase-realtime-batch": {
      "types": "./dist/supabase-realtime-batch.d.ts",
      "default": "./dist/supabase-realtime-batch.js"
    },
    "./supabase-websocket-ingest": {
      "types": "./dist/supabase-websocket-ingest.d.ts",
      "default": "./dist/supabase-websocket-ingest.js"
    },
    "./supabase-websocket-persistent": {
      "types": "./dist/supabase-websocket-persistent.d.ts",
      "default": "./dist/supabase-websocket-persistent.js"
    },
    "./wasm": {
      "types": "./dist/wasm-logger.d.ts",
      "default": "./dist/wasm-logger.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./eslint": {
      "types": "./dist/eslint-plugin.d.ts",
      "default": "./dist/eslint-plugin.js"
    },
    "./server-lifecycle": {
      "types": "./dist/server-lifecycle.d.ts",
      "import": "./dist/server-lifecycle.js",
      "default": "./dist/server-lifecycle.js"
    },
    "./execution-context": {
      "browser": {
        "types": "./dist/execution-context-browser.d.ts",
        "default": "./dist/execution-context-browser.js"
      },
      "workerd": {
        "types": "./dist/execution-context-workerd.d.ts",
        "default": "./dist/execution-context-workerd.js"
      },
      "types": "./dist/execution-context.d.ts",
      "default": "./dist/execution-context.js"
    },
    "./contracts/log-record.schema.json": "./contracts/log-record.schema.json",
    "./contracts/logger-api.schema.json": "./contracts/logger-api.schema.json",
    "./contracts/logger-api.json": "./contracts/logger-api.json",
    "./contracts/test-org-matrix.schema.json": "./contracts/test-org-matrix.schema.json",
    "./contracts/test-org-matrix.json": "./contracts/test-org-matrix.json",
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run postbuild && npm run stage:nodejs",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli/main.js', 0o755)\"",
    "prepare": "tsc -p tsconfig.build.json && npm run postbuild",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run build && tsc -p tests/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:contracts": "node scripts/validate-contracts.mjs && node scripts/test-observability-contracts.mjs",
    "test:sidecar": "node --test tests/sidecar.test.mjs",
    "test:formal": "npm run build && node scripts/check-formal-model.mjs && node --test tests/formal-model.test.mjs",
    "test:polyglot": "node scripts/test-polyglot.mjs",
    "test:runtimes": "node scripts/test-runtimes.mjs",
    "test:all": "npm run test:contracts && npm test && npm run test:runtimes && npm run test:polyglot",
    "stage:nodejs": "node scripts/stage-nodejs-release.mjs",
    "release:check": "npm run test:contracts && npm run test:sidecar && npm run build && node --test tests/zpkg.test.mjs && npm pack ./sdk/nodejs --dry-run --json --ignore-scripts",
    "prepack": "npm run test:contracts && npm test",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores",
    "prebuild": "npm run lint:ores"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ores-otel/ores.otel.log.git"
  },
  "homepage": "https://github.com/ores-otel/ores.otel.log#readme",
  "bugs": {
    "url": "https://github.com/ores-otel/ores.otel.log/issues"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "eslint": ">=9 <11"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "keywords": [
    "logging",
    "opentelemetry",
    "otel",
    "loki",
    "prometheus",
    "grafana",
    "nextjs",
    "esm",
    "supabase",
    "bun",
    "deno",
    "edge",
    "cloudflare-workers",
    "workerd"
  ],
  "license": "MIT",
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
