{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/sdk-manifest.schema.json",
  "title": "ores.otel.log SDK conformance manifest",
  "description": "Machine-readable logical API, context, telemetry, repository, and test contract for one language SDK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "language",
    "ecosystem",
    "runtime",
    "sourceRoot",
    "package",
    "repositories",
    "wire",
    "api",
    "context",
    "telemetry",
    "conformance",
    "promotion"
  ],
  "properties": {
    "manifestVersion": {
      "const": "ores.otel.sdk-manifest/v1"
    },
    "language": {
      "type": "string",
      "enum": [
        "nodejs",
        "python",
        "go",
        "rust",
        "java",
        "dart",
        "gleam",
        "erlang",
        "elixir",
        "ruby",
        "wasm"
      ]
    },
    "ecosystem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "runtime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceRoot": {
      "allOf": [
        {
          "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/repositoryPath"
        },
        {
          "pattern": "^sdk/"
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyName",
        "canonicalName",
        "nativeModule"
      ],
      "properties": {
        "legacyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "canonicalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "nativeModule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "legacy"
      ],
      "properties": {
        "canonical": {
          "const": "ores-otel/ores.otel.log"
        },
        "legacy": {
          "const": "ORESoftware/next-loggers.ts"
        }
      }
    },
    "wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordVersion",
        "recordSchema",
        "contextSchema",
        "otelLogSchema",
        "batchSchema"
      ],
      "properties": {
        "recordVersion": {
          "const": "next-loggers/v1"
        },
        "recordSchema": {
          "const": "contracts/log-record.schema.json"
        },
        "contextSchema": {
          "const": "contracts/schemas/log-context.schema.json"
        },
        "otelLogSchema": {
          "const": "contracts/schemas/otel-log-record.schema.json"
        },
        "batchSchema": {
          "const": "contracts/schemas/transport-batch.schema.json"
        },
        "realtimeBatchVersion": {
          "const": "next-loggers/realtime-batch/v1"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logger",
        "event",
        "transport"
      ],
      "properties": {
        "logger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "fatal",
            "flush",
            "flushOnExit",
            "close"
          ],
          "properties": {
            "trace": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "debug": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "info": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "warn": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "error": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "fatal": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "flush": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "flushOnExit": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "close": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            }
          }
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "addFields",
            "addTrace",
            "addRoutineId",
            "addTags",
            "addContext",
            "addMeta",
            "addUser",
            "send"
          ],
          "properties": {
            "addFields": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "addTrace": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "addRoutineId": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "addTags": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "addContext": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "addMeta": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "addUser": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "send": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "otelRouting": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "write",
            "flush",
            "flushOnExit",
            "close"
          ],
          "properties": {
            "write": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "flush": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "flushOnExit": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "close": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "strategy",
        "propagation",
        "isolation",
        "symbols",
        "mergesLoggedInUser",
        "mergesFields",
        "deduplicatesTraceIds",
        "restoresAfterFailure"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "partial"
          ]
        },
        "strategy": {
          "type": "string",
          "enum": [
            "async-local-storage",
            "contextvars",
            "context-value",
            "thread-local",
            "thread-local-and-task-scope",
            "zone",
            "process-dictionary",
            "fiber-local-and-thread-local",
            "explicit-host-context"
          ]
        },
        "propagation": {
          "type": "string",
          "enum": [
            "async",
            "task",
            "thread",
            "process",
            "zone",
            "fiber",
            "explicit"
          ]
        },
        "isolation": {
          "type": "string",
          "enum": [
            "concurrent-safe",
            "sequential-only",
            "caller-owned"
          ]
        },
        "symbols": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run",
            "current",
            "update",
            "apply",
            "withSpan"
          ],
          "properties": {
            "run": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "current": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "update": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "apply": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "withSpan": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            }
          }
        },
        "mergesLoggedInUser": {
          "type": "boolean"
        },
        "mergesFields": {
          "type": "boolean"
        },
        "deduplicatesTraceIds": {
          "type": "boolean"
        },
        "restoresAfterFailure": {
          "type": "boolean"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opentelemetry",
        "supabase"
      ],
      "properties": {
        "opentelemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapterSymbols",
            "explicit",
            "automaticInstrumentation",
            "monkeyPatching",
            "ownsProvider",
            "wrapsLoggerCalls",
            "sampledOutCorrelation",
            "recordingSpanEventsOnly"
          ],
          "properties": {
            "adapterSymbols": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "explicit": {
              "const": true
            },
            "automaticInstrumentation": {
              "const": false
            },
            "monkeyPatching": {
              "const": false
            },
            "ownsProvider": {
              "const": false
            },
            "wrapsLoggerCalls": {
              "const": true
            },
            "sampledOutCorrelation": {
              "type": "boolean"
            },
            "recordingSpanEventsOnly": {
              "type": "boolean"
            }
          }
        },
        "supabase": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapterSymbols",
            "authenticatedSender",
            "durableBatchSchema",
            "allowsDistributedSecrets",
            "realtimeIsDurable"
          ],
          "properties": {
            "adapterSymbols": {
              "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/symbolList"
            },
            "authenticatedSender": {
              "const": true
            },
            "durableBatchSchema": {
              "const": "next-loggers/batch/v1"
            },
            "realtimeBatchSchema": {
              "const": "next-loggers/realtime-batch/v1"
            },
            "privateChannelsByDefault": {
              "const": true
            },
            "realtimeAcknowledgements": {
              "const": true
            },
            "durableFallbackSupported": {
              "const": true
            },
            "allowsDistributedSecrets": {
              "const": false
            },
            "realtimeIsDurable": {
              "const": false
            }
          }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "recordFixture",
        "sourceFiles",
        "validatesJsonSchema",
        "testsContextIsolation",
        "testsNoMonkeyPatching"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recordFixture": {
          "const": "contracts/fixtures/conformance-record.json"
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json#/$defs/repositoryPath"
          }
        },
        "validatesJsonSchema": {
          "type": "boolean"
        },
        "testsContextIsolation": {
          "type": "boolean"
        },
        "testsNoMonkeyPatching": {
          "type": "boolean"
        },
        "testsRealtimeAcknowledgements": {
          "type": "boolean"
        },
        "testsDurableFallback": {
          "type": "boolean"
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "blockers"
      ],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ready": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
