{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/common.schema.json",
  "title": "ores.otel.log common JSON values",
  "description": "Reusable bounded JSON, correlation, level, path, and symbol definitions for the ores.otel.log v1 contracts.",
  "$defs": {
    "level": {"type": "string", "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]},
    "nonEmptyString": {"type": "string", "minLength": 1, "maxLength": 256},
    "boundedString": {"type": "string", "maxLength": 16384},
    "repositoryName": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 200},
    "repositoryPath": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.@+/-]+$"},
    "symbol": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z_][A-Za-z0-9_.$:#/-]*$"},
    "symbolList": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
    "w3cTraceId": {"type": "string", "pattern": "^[0-9a-f]{32}$", "not": {"const": "00000000000000000000000000000000"}},
    "w3cSpanId": {"type": "string", "pattern": "^[0-9a-f]{16}$", "not": {"const": "0000000000000000"}},
    "legacyCorrelationId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "traceId": {
      "description": "A preferred lowercase W3C trace ID or a legacy v1 correlation ID retained for wire compatibility.",
      "allOf": [
        {"anyOf": [{"$ref": "#/$defs/w3cTraceId"}, {"$ref": "#/$defs/legacyCorrelationId"}]},
        {"not": {"const": "00000000000000000000000000000000"}}
      ]
    },
    "spanId": {
      "description": "A preferred lowercase W3C span ID or a legacy v1 correlation ID retained for wire compatibility.",
      "allOf": [
        {"anyOf": [{"$ref": "#/$defs/w3cSpanId"}, {"$ref": "#/$defs/legacyCorrelationId"}]},
        {"not": {"const": "0000000000000000"}}
      ]
    },
    "traceFlags": {"type": "integer", "minimum": 0, "maximum": 255},
    "jsonPrimitive": {"type": ["null", "boolean", "number", "string"]},
    "jsonArray": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/jsonValue"}},
    "jsonObject": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 256},
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "jsonValue": {"anyOf": [{"$ref": "#/$defs/jsonPrimitive"}, {"$ref": "#/$defs/jsonArray"}, {"$ref": "#/$defs/jsonObject"}]},
    "stringMap": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 256},
      "additionalProperties": {"type": "string", "maxLength": 4096}
    },
    "tagList": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  }
}
