{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ores-otel/ores.otel.log/main/contracts/schemas/backpressure-conformance-report.schema.json",
  "title": "ores.otel.log bounded-backpressure conformance report",
  "description": "Identity-only result envelope. Receipts and sensitive input values are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportVersion",
    "contract",
    "schemaVersion",
    "vectorSet",
    "vectorDigest",
    "implementation",
    "runtime",
    "results"
  ],
  "properties": {
    "reportVersion": {"const": "ores.otel.log/conformance-report/v1"},
    "contract": {"const": "ores.otel.log/backpressure-result/v1"},
    "schemaVersion": {"const": 1},
    "vectorSet": {"const": "ores.otel.log/backpressure-vectors/v1"},
    "vectorDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version", "sourceSha"],
      "properties": {
        "language": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "sourceSha": {
          "type": "string",
          "pattern": "^(?!0000000000000000000000000000000000000000$)[0-9a-f]{40}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "failures"],
      "properties": {
        "total": {"type": "integer", "minimum": 1, "maximum": 128},
        "passed": {"type": "integer", "minimum": 0, "maximum": 128},
        "failed": {"type": "integer", "minimum": 0, "maximum": 128},
        "failures": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "expectedValid",
              "actualValid",
              "expectedRule",
              "actualRule"
            ],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
              "expectedValid": {"type": "boolean"},
              "actualValid": {"type": "boolean"},
              "expectedRule": {"type": "string", "minLength": 1, "maxLength": 64},
              "actualRule": {"type": "string", "minLength": 1, "maxLength": 64}
            }
          }
        }
      }
    }
  }
}
