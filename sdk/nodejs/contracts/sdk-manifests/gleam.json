{
  "manifestVersion": "ores.otel.sdk-manifest/v1",
  "language": "gleam",
  "ecosystem": "Hex",
  "runtime": "Gleam on BEAM",
  "sourceRoot": "sdk/gleam",
  "package": {
    "legacyName": "oresoftware_next_loggers",
    "canonicalName": "ores_otel_log",
    "nativeModule": "ores_otel_log"
  },
  "repositories": {
    "canonical": "ores-otel/ores.otel.log",
    "legacy": "ORESoftware/next-loggers.ts"
  },
  "wire": {
    "recordVersion": "next-loggers/v1",
    "recordSchema": "contracts/log-record.schema.json",
    "contextSchema": "contracts/schemas/log-context.schema.json",
    "otelLogSchema": "contracts/schemas/otel-log-record.schema.json",
    "batchSchema": "contracts/schemas/transport-batch.schema.json"
  },
  "api": {
    "logger": {
      "trace": [
        "trace"
      ],
      "debug": [
        "debug"
      ],
      "info": [
        "info",
        "log"
      ],
      "warn": [
        "warn"
      ],
      "error": [
        "error"
      ],
      "fatal": [
        "fatal"
      ],
      "flush": [
        "flush"
      ],
      "flushOnExit": [
        "flush_on_exit"
      ],
      "close": [
        "close"
      ]
    },
    "event": {
      "addFields": [
        "add_fields"
      ],
      "addTrace": [
        "add_trace",
        "add_trace_id"
      ],
      "addRoutineId": [
        "add_routine_id"
      ],
      "addTags": [
        "add_tags"
      ],
      "addContext": [
        "add_context"
      ],
      "addMeta": [
        "add_meta"
      ],
      "addUser": [
        "add_user_info",
        "add_logged_in_user_info"
      ],
      "send": [
        "send"
      ],
      "otelRouting": [
        "use_otel",
        "not_otel",
        "with_otel",
        "reset_otel",
        "is_otel_enabled"
      ]
    },
    "transport": {
      "write": [
        "write"
      ],
      "flush": [
        "flush"
      ],
      "flushOnExit": [
        "flush_on_exit"
      ],
      "close": [
        "close"
      ]
    }
  },
  "context": {
    "status": "partial",
    "strategy": "explicit-host-context",
    "propagation": "explicit",
    "isolation": "caller-owned",
    "symbols": {
      "run": [
        "with_span"
      ],
      "current": [
        "OtelSpan.context"
      ],
      "update": [
        "OtelSpanContext"
      ],
      "apply": [
        "apply_span_context"
      ],
      "withSpan": [
        "with_span"
      ]
    },
    "mergesLoggedInUser": true,
    "mergesFields": true,
    "deduplicatesTraceIds": true,
    "restoresAfterFailure": true
  },
  "telemetry": {
    "opentelemetry": {
      "adapterSymbols": [
        "otel_transport",
        "with_span",
        "apply_span_context"
      ],
      "explicit": true,
      "automaticInstrumentation": false,
      "monkeyPatching": false,
      "ownsProvider": false,
      "wrapsLoggerCalls": true,
      "sampledOutCorrelation": true,
      "recordingSpanEventsOnly": true
    },
    "supabase": {
      "adapterSymbols": [
        "supabase_transport"
      ],
      "authenticatedSender": true,
      "durableBatchSchema": "next-loggers/batch/v1",
      "allowsDistributedSecrets": false,
      "realtimeIsDurable": false
    }
  },
  "conformance": {
    "command": "cd sdk/gleam && gleam format --check src test && gleam test",
    "recordFixture": "contracts/fixtures/conformance-record.json",
    "sourceFiles": [
      "sdk/gleam/src/oresoftware_next_loggers.gleam",
      "sdk/gleam/test/oresoftware_next_loggers_test.gleam"
    ],
    "validatesJsonSchema": false,
    "testsContextIsolation": false,
    "testsNoMonkeyPatching": false
  },
  "promotion": {
    "ready": false,
    "blockers": [
      "Expand explicit span context to the complete canonical user and baggage merge contract.",
      "Validate Gleam-emitted records directly against the canonical JSON Schema."
    ]
  }
}
