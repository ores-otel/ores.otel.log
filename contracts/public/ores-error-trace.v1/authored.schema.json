{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ores-otel/ores-otel-interfaces/contracts/ores-error-trace.v1/authored.schema.json",
  "$defs": {
    "OresErrorTraceTelemetryV1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "OresErrorTraceTelemetryV1.json",
      "type": "object",
      "properties": {
        "version": { "type": "integer", "minimum": 1, "maximum": 1 },
        "kind": { "const": "error", "type": "string" },
        "service": { "type": "string", "minLength": 1, "maxLength": 256 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "repository": { "type": "string", "minLength": 1, "maxLength": 256 },
        "release_sha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
        "trace_id": { "type": "string", "pattern": "^ores-trace-[A-Za-z0-9_-]{12,64}$" },
        "parent_trace_id": { "type": "string", "pattern": "^ores-trace-[A-Za-z0-9_-]{12,64}$" },
        "otel_trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "otel_span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "exception_type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "error_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "error_code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "maxLength": 8192 },
        "error_list": { "type": "array", "maxItems": 32, "items": { "type": "string" } },
        "top_frame": { "type": "string", "maxLength": 1024 },
        "operation": { "type": "string", "maxLength": 512 },
        "severity": { "type": "string", "maxLength": 32 },
        "runtime": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 128 },
        "routine_id": { "type": "string", "pattern": "^ores-routine-[A-Za-z0-9_-]{12,64}$" },
        "file_name": { "type": "string", "maxLength": 1024 }
      },
      "required": ["version", "kind", "service"],
      "unevaluatedProperties": false
    }
  }
}
