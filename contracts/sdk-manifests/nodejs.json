{
  "manifestVersion": "ores.otel.sdk-manifest/v1",
  "language": "nodejs",
  "ecosystem": "npm",
  "runtime": "Node.js, Bun, Deno, browsers, and workerd",
  "sourceRoot": "sdk/nodejs",
  "package": {
    "legacyName": "@oresoftware/next-loggers",
    "canonicalName": "@ores-otel/ores.otel.log",
    "nativeModule": "@ores-otel/ores.otel.log"
  },
  "repositories": {
    "canonical": "ores-otel/ores.otel.log",
    "legacy": "ORESoftware/next-loggers.ts"
  },
  "wire": {
    "recordVersion": "next-loggers/v1",
    "recordSchema": "contracts/log-record.schema.json",
    "contextSchema": "contracts/schemas/log-context.schema.json",
    "otelLogSchema": "contracts/schemas/otel-log-record.schema.json",
    "batchSchema": "contracts/schemas/transport-batch.schema.json"
  },
  "api": {
    "logger": {
      "trace": [
        "trace"
      ],
      "debug": [
        "debug"
      ],
      "info": [
        "info",
        "log"
      ],
      "warn": [
        "warn"
      ],
      "error": [
        "error"
      ],
      "fatal": [
        "fatal"
      ],
      "flush": [
        "flush"
      ],
      "flushOnExit": [
        "flushOnExit"
      ],
      "close": [
        "close"
      ]
    },
    "event": {
      "addFields": [
        "addFields"
      ],
      "addTrace": [
        "addTrace",
        "addTraceId"
      ],
      "addRoutineId": [
        "addRoutineId"
      ],
      "addTags": [
        "addTags"
      ],
      "addContext": [
        "addContext"
      ],
      "addMeta": [
        "addMeta"
      ],
      "addUser": [
        "addUserInfo",
        "addLoggedInUserInfo"
      ],
      "send": [
        "send"
      ],
      "otelRouting": [
        "useOtel",
        "notOtel",
        "withOtel",
        "resetOtel",
        "isOtelEnabled"
      ]
    },
    "transport": {
      "write": [
        "write"
      ],
      "flush": [
        "flush"
      ],
      "flushOnExit": [
        "flushOnExit"
      ],
      "close": [
        "close"
      ]
    }
  },
  "context": {
    "status": "implemented",
    "strategy": "async-local-storage",
    "propagation": "async",
    "isolation": "concurrent-safe",
    "symbols": {
      "run": [
        "runWithLogContext"
      ],
      "current": [
        "getLogContext"
      ],
      "update": [
        "updateLogContext"
      ],
      "apply": [
        "setLogContextProvider"
      ],
      "withSpan": [
        "withOpenTelemetrySpan"
      ]
    },
    "mergesLoggedInUser": true,
    "mergesFields": true,
    "deduplicatesTraceIds": true,
    "restoresAfterFailure": true
  },
  "telemetry": {
    "opentelemetry": {
      "adapterSymbols": [
        "OpenTelemetryTransport",
        "createOpenTelemetryTransport",
        "createOpenTelemetryContextProvider",
        "withOpenTelemetry",
        "withOpenTelemetrySpan"
      ],
      "explicit": true,
      "automaticInstrumentation": false,
      "monkeyPatching": false,
      "ownsProvider": false,
      "wrapsLoggerCalls": true,
      "sampledOutCorrelation": true,
      "recordingSpanEventsOnly": true
    },
    "supabase": {
      "adapterSymbols": [
        "SupabaseIngestTransport",
        "createSupabaseIngestTransport"
      ],
      "authenticatedSender": true,
      "durableBatchSchema": "next-loggers/batch/v1",
      "allowsDistributedSecrets": false,
      "realtimeIsDurable": false
    }
  },
  "conformance": {
    "command": "npm test",
    "recordFixture": "contracts/fixtures/conformance-record.json",
    "sourceFiles": [
      "src/base-logger.ts",
      "src/context.ts",
      "src/context-shared.ts",
      "src/otel.ts",
      "src/supabase-ingest.ts"
    ],
    "validatesJsonSchema": true,
    "testsContextIsolation": true,
    "testsNoMonkeyPatching": true
  },
  "promotion": {
    "ready": true,
    "blockers": []
  }
}
