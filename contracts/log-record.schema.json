{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/next-loggers.ts/contracts/log-record.schema.json",
  "title": "next-loggers/v1 log record",
  "description": "Canonical wire record shared by every next-loggers language SDK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "timestamp",
    "level",
    "runtime",
    "appName",
    "message",
    "values",
    "fields"
  ],
  "properties": {
    "schema": {
      "const": "next-loggers/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "FATAL"
      ]
    },
    "runtime": {
      "type": "string",
      "minLength": 1
    },
    "appName": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "values": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "fields": {
      "$ref": "#/$defs/jsonObject"
    },
    "loggedInUser": {
      "$ref": "#/$defs/jsonObject"
    },
    "users": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jsonObject"
      }
    },
    "traceId": {
      "type": "string"
    },
    "traceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "routineId": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "meta": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "stackTrace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "$ref": "#/$defs/jsonObject"
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    }
  }
}
